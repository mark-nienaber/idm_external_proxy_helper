# AIC IDM Proxy Configuration
# Copy this file to .env and fill in your values

# AIC Instance 1 (Source - where proxy is created)
AIC1_TENANT=
AIC1_SERVICE_ACCOUNT_ID=
AIC1_JWK_PATH=./keys/markproxyalpha_privateKey.jwk
AIC1_ACCESS_TOKEN=

# AIC Instance 2 (Target - where data is queried from)
AIC2_TENANT=
AIC2_SERVICE_ACCOUNT_ID=9518623d-2112-4a64-9237-d43288d4e64d
AIC2_JWK_PATH=./keys/idm2proxy_privateKey.jwk
AIC2_ACCESS_TOKEN=

# External IDM Configuration (for creating the external.idm config)
# Config name for external IDM reference
EXTERNAL_IDM_CONFIG_NAME=idm2

# OAuth Client credentials for external IDM authentication to AIC2
EXTERNAL_IDM_CLIENT_ID=idmprovisioning
EXTERNAL_IDM_CLIENT_SECRET=password

# OAuth Realm on AIC2 (alpha or bravo)
EXTERNAL_IDM_REALM=alpha

# Global variable to store OAuth client access token
OAUTH_CLIENT_ACCESS_TOKEN=

# API Endpoints
AIC1_BASE_URL=https://${AIC1_TENANT}.forgeblocks.com
AIC2_BASE_URL=https://${AIC2_TENANT}.forgeblocks.com
